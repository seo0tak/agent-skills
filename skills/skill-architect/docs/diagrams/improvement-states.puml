' skill-architect 개선 기록 상태 전이. 고친 뒤 저장소 루트에서 python3 scripts/render_diagrams.py
@startuml
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Apple SD Gothic Neo"
hide empty description
state "적용 전" as before {
  state captured
  state proposed
  state evaluated
  state approved
  [*] --> captured : capture
  captured --> proposed : 변경안 · 대상 SHA256 · 복구 방법
  proposed --> evaluated : 변경 전·후 평가 · 회귀
  evaluated --> approved : 평가 · 회귀 pass + 사용자 권한 참조
  evaluated -up-> proposed : 제안 갱신 (approved에서도)
}
state "적용 후" as after {
  state applied
  state verified
  applied --> verified : 적용 후 회귀 pass · 복구 사본 확인
}
state rejected
state "rolled-back" as rolled_back
approved --> applied : 대상 SHA256이 제안 때와 같음
before --> rejected : 적용 전에만
after --> rolled_back : 계획한 복구 버전으로
verified --> [*]
rejected --> [*]
rolled_back --> [*]
@enduml
