{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sast/item-guide.schema.json",
  "title": "SAST 항목별 검토 가이드",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "sequence",
    "title",
    "sourceMapping",
    "summary"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string"
    },
    "sourceMapping": {
      "enum": [
        "unreviewed",
        "exact",
        "relocated",
        "changed",
        "not-found",
        "generated-or-external"
      ]
    },
    "summary": {
      "type": "string"
    },
    "applicability": {
      "type": "string",
      "description": "원래 규칙의 검출 조건·적용 범위와 현재 항목의 충족/불충족/미확인 근거. 피해가 작거나 미재현이라는 사실만으로 불충족으로 쓰지 않는다."
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "impact": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "testPlan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "duplicateGroup": {
      "type": "string"
    },
    "relatedIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "policyQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "detail"
        ],
        "properties": {
          "source": {
            "enum": [
              "report",
              "source",
              "project-policy",
              "baseline",
              "inference"
            ]
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "groupGuideRef": {
      "type": "string",
      "description": "그룹 대표 가이드의 검출 ID. 기본 필수 필드를 유지하며, 이 항목의 호출부·타입·설정 등 핵심 전제와 대표의 차이를 summary에 기록하고 필요한 경우 delta에 추가한다. 참조만으로 같은 결론을 확정하지 않는다."
    },
    "delta": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "대표 가이드와 다른 점만 기록"
    }
  },
  "additionalProperties": true
}
