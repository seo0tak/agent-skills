{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sast/result.schema.json",
  "title": "SAST 항목별 조치 결과",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "sequence",
    "workflowStatus",
    "conclusion",
    "reason",
    "resultFiles",
    "resultSummary",
    "resultCodeDiff",
    "resultGuideComparison",
    "impact",
    "verification",
    "duplicates",
    "evidenceNote",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "workflowStatus": {
      "description": "실제로 도달한 작업 단계. conclusion과 독립적이며, 수정 제안만으로 change-complete 또는 verified가 되지 않는다.",
      "enum": [
        "todo",
        "in-progress",
        "analyzed",
        "change-complete",
        "verified",
        "deferred"
      ]
    },
    "conclusion": {
      "description": "검출 항목의 처리 결론. 규칙 적용 여부·현재 영향·조치 필요성의 근거는 reason에 기록한다. false-positive와 예방 수정 완료는 함께 기록할 수 있다.",
      "enum": [
        "unreviewed",
        "fix",
        "false-positive",
        "operations",
        "exception",
        "needs-review"
      ]
    },
    "reason": {
      "type": "string",
      "description": "검출 규칙·출처와 적용 여부, 현재 소스·호출부 근거, 조치 필요성(필수/예방/불필요/판단 보류)을 구분해 설명한다. 이 문자열의 구조 검사는 의미 판정의 정당성을 보장하지 않는다."
    },
    "resultFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resultSummary": {
      "type": "string",
      "description": "실제로 적용한 내용. 제안·예정·미변경과 완료한 수정을 구분하고, 예방 수정이면 목적과 승인 범위를 설명한다."
    },
    "resultCodeDiff": {
      "type": "string"
    },
    "resultGuideComparison": {
      "type": "string"
    },
    "impact": {
      "type": "array",
      "description": "현재 영향, 안전 판단이 의존하는 호출부·타입·설정 등 전제와 미확인 범위. 변경 영향도 함께 구분해 기록한다.",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "status",
        "commands",
        "results",
        "limitations",
        "verifiedAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "not-run",
            "passed",
            "failed",
            "partial",
            "manual-required"
          ]
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "results": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verifiedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "method": {
          "type": "string",
          "description": "검증 수단 — 프로필 validation.verificationMeans에 선언된 값 중 하나 (예: build, lint, unit-test, scanner-recheck, manual-review)"
        },
        "sourceSnapshot": {
          "type": "object",
          "description": "sast_state.py seal-verification이 생성하는 선택적 소스·검증 근거 연결 정보. 이 정보가 없는 옛 검증 근거는 unbound이며 자동으로 fresh로 간주하지 않는다. 기록된 파일만 연결 범위에 포함된다.",
          "required": ["schemaVersion", "workspaceId", "projectRoot", "id", "capturedAt", "files", "sealedAt", "evidenceDigest"],
          "properties": {
            "schemaVersion": {"const": "1.0"},
            "workspaceId": {"type": "string", "minLength": 1},
            "projectRoot": {"type": "string", "minLength": 1},
            "id": {"type": "string", "minLength": 1},
            "capturedAt": {"type": "string", "format": "date-time"},
            "sealedAt": {"type": "string", "format": "date-time"},
            "files": {
              "type": "object",
              "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "evidenceDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "duplicates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidenceNote": {
      "type": "string",
      "description": "제출 검토용 요약: 결론 근거·현재 안전 조건·실제 조치·남은 확인 및 재검토 조건. 승인·검증을 수행하지 않았다면 완료한 것으로 표현하지 않는다."
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
