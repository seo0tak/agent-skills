{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sast/input-validation.schema.json",
  "title": "SAST 입력 검증",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "checkedAt",
    "project",
    "inputs",
    "checks",
    "matching",
    "blockers",
    "notes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "unreviewed",
        "mechanical-ready",
        "ready",
        "blocked"
      ]
    },
    "checkedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "identity",
        "identityEvidence"
      ],
      "properties": {
        "root": {
          "type": "string"
        },
        "identity": {
          "type": "string"
        },
        "identityEvidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pdf",
        "spreadsheet"
      ],
      "properties": {
        "set": {
          "type": [
            "string",
            "null"
          ]
        },
        "pdf": {
          "$ref": "#/$defs/inputFile"
        },
        "spreadsheet": {
          "$ref": "#/$defs/inputFile"
        },
        "sarif": {
          "$ref": "#/$defs/inputFile"
        },
        "manifest": {
          "type": "array",
          "description": "전체 입력 파일의 경로·크기·SHA-256. ready 승인에는 필수이며, 과거 승인에 없으면 preflight와 의미 대조를 다시 수행한다.",
          "items": {
            "$ref": "#/$defs/inputFingerprint"
          },
          "uniqueItems": true
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "status",
          "summary",
          "evidence"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "manual"
            ]
          },
          "summary": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "matching": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sameProject",
        "sameRun",
        "findingCountConsistent",
        "sourceScopeCompatible",
        "reason"
      ],
      "properties": {
        "sameProject": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "sameRun": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "findingCountConsistent": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "sourceScopeCompatible": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "inputFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "inputFile": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "path",
        "size",
        "format",
        "formatValid",
        "evidence"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "format": {
          "type": "string"
        },
        "formatValid": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string"
        }
      }
    }
  }
}
