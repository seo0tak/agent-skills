{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sast/checker-guides.schema.json",
  "title": "SAST 체커별 가이드",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": ["code", "name", "description", "cwe", "reportGuidance", "reviewNotes", "verificationFocus"],
    "properties": {
      "code": { "type": "string", "minLength": 1 },
      "name": { "type": "string" },
      "description": { "type": "string" },
      "plainDescription": {
        "type": "string",
        "description": "보안 배경지식 없이도 이해할 수 있는 한두 줄 설명. 문제가 생기는 조건과 업무에 미칠 영향을 설명한다. 정책 질문과 대시보드에 '쉽게 말하면'으로 표시된다."
      },
      "cwe": { "type": "array", "items": { "type": "string" } },
      "reportGuidance": { "type": "string" },
      "vulnerableExample": { "type": "string" },
      "solutionExample": { "type": "string" },
      "reviewNotes": { "type": "string" },
      "verificationFocus": { "type": "array", "items": { "type": "string" } },
      "sourcePages": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
      "sourceType": { "const": "report" }
    },
    "additionalProperties": true
  }
}
