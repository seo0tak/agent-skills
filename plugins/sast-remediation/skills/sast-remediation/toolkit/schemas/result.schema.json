{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sast/result.schema.json",
  "title": "SAST 항목별 조치 결과",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "sequence",
    "workflowStatus",
    "conclusion",
    "reason",
    "resultFiles",
    "resultSummary",
    "resultCodeDiff",
    "resultGuideComparison",
    "impact",
    "verification",
    "duplicates",
    "evidenceNote",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "workflowStatus": {
      "enum": [
        "todo",
        "in-progress",
        "analyzed",
        "change-complete",
        "verified",
        "deferred"
      ]
    },
    "conclusion": {
      "enum": [
        "unreviewed",
        "fix",
        "false-positive",
        "operations",
        "exception",
        "needs-review"
      ]
    },
    "reason": {
      "type": "string"
    },
    "resultFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resultSummary": {
      "type": "string"
    },
    "resultCodeDiff": {
      "type": "string"
    },
    "resultGuideComparison": {
      "type": "string"
    },
    "impact": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "status",
        "commands",
        "results",
        "limitations",
        "verifiedAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "not-run",
            "passed",
            "failed",
            "partial",
            "manual-required"
          ]
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "results": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verifiedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "method": {
          "type": "string",
          "description": "검증 수단 — 프로필 validation.verificationMeans에 선언된 값 중 하나 (예: build, lint, unit-test, scanner-recheck, manual-review)"
        },
        "sourceSnapshot": {
          "type": "object",
          "description": "sast_state.py seal-verification이 생성하는 선택적 소스·검증 근거 연결 정보. 이 정보가 없는 옛 검증 근거는 unbound이며 자동으로 fresh로 간주하지 않는다. 기록된 파일만 연결 범위에 포함된다.",
          "required": ["schemaVersion", "workspaceId", "projectRoot", "id", "capturedAt", "files", "sealedAt", "evidenceDigest"],
          "properties": {
            "schemaVersion": {"const": "1.0"},
            "workspaceId": {"type": "string", "minLength": 1},
            "projectRoot": {"type": "string", "minLength": 1},
            "id": {"type": "string", "minLength": 1},
            "capturedAt": {"type": "string", "format": "date-time"},
            "sealedAt": {"type": "string", "format": "date-time"},
            "files": {
              "type": "object",
              "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "evidenceDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "duplicates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidenceNote": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
