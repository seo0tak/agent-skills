{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sast/result.schema.json",
  "title": "SAST Item Result",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "sequence",
    "workflowStatus",
    "conclusion",
    "reason",
    "resultFiles",
    "resultSummary",
    "resultCodeDiff",
    "resultGuideComparison",
    "impact",
    "verification",
    "duplicates",
    "evidenceNote",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "workflowStatus": {
      "enum": ["todo", "in-progress", "analyzed", "change-complete", "verified", "deferred"]
    },
    "conclusion": {
      "enum": ["unreviewed", "fix", "false-positive", "operations", "exception", "needs-review"]
    },
    "reason": { "type": "string" },
    "resultFiles": { "type": "array", "items": { "type": "string" } },
    "resultSummary": { "type": "string" },
    "resultCodeDiff": { "type": "string" },
    "resultGuideComparison": { "type": "string" },
    "impact": { "type": "array", "items": { "type": "string" } },
    "verification": {
      "type": "object",
      "required": ["status", "commands", "results", "limitations", "verifiedAt"],
      "properties": {
        "status": { "enum": ["not-run", "passed", "failed", "partial", "manual-required"] },
        "commands": { "type": "array", "items": { "type": "string" } },
        "results": { "type": "array", "items": { "type": "string" } },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "verifiedAt": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": true
    },
    "duplicates": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "evidenceNote": { "type": "string" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
