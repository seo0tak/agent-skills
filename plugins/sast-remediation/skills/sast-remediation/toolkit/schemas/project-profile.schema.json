{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sast/project-profile.schema.json",
  "title": "SAST 프로젝트 프로필",
  "type": "object",
  "required": [
    "schemaVersion",
    "workspaceId",
    "projectName",
    "generatedAt",
    "report",
    "technology",
    "paths",
    "modules",
    "validation",
    "constraints"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "workspaceId": {
      "type": "string"
    },
    "projectName": {
      "type": "string"
    },
    "generatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "report": {
      "type": "object",
      "required": [
        "id",
        "pdf",
        "spreadsheet",
        "generatedAt",
        "findingCount"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "pdf": {
          "type": "string"
        },
        "spreadsheet": {
          "type": "string"
        },
        "generatedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "findingCount": {
          "type": "integer",
          "minimum": 0
        },
        "inputsMatch": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "mismatchReason": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "technology": {
      "type": "object",
      "required": [
        "languages",
        "frameworks",
        "buildTools",
        "testFrameworks"
      ],
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "buildTools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "testFrameworks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "paths": {
      "type": "object",
      "required": [
        "sourceRoots",
        "testRoots",
        "configRoots",
        "templateRoots"
      ],
      "properties": {
        "sourceRoots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "testRoots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "configRoots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "templateRoots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "testPath": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "compileCommands",
        "testCommands"
      ],
      "properties": {
        "compileCommands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "testCommands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "successSignals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verificationMeans": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "이 프로젝트에서 사용 가능한 검증 방법 목록 (예: build, lint, unit-test, scanner-recheck, manual-review)"
        }
      },
      "additionalProperties": true
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scope",
          "rule",
          "source"
        ],
        "properties": {
          "scope": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "source": {
            "enum": [
              "source",
              "report",
              "project-policy",
              "baseline",
              "inference"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "outputs": {
          "type": "object",
          "properties": {
            "allResults": {
              "type": "string"
            },
            "falsePositiveOpinions": {
              "type": "string"
            },
            "operationsRequired": {
              "type": "string"
            },
            "unverifiedReview": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "analysisSummary": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
