{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sast/decisions.schema.json",
  "title": "SAST Policy Decisions",
  "description": "정책 질문에 대한 결정의 정본. project/DECISION_LOG.md는 sync가 이 파일에서 생성한다.",
  "type": "object",
  "required": ["schemaVersion", "workspaceId", "updatedAt", "decisions"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "workspaceId": { "type": "string" },
    "updatedAt": { "type": ["string", "null"], "format": "date-time" },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "decidedAt", "topic", "question", "decidedBy", "decision", "scope", "rationale", "checkers", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "description": "예: DEC-001. 차수 안에서 유일." },
          "decidedAt": { "type": "string", "format": "date-time" },
          "topic": { "type": "string", "minLength": 1, "description": "업무 사실로 쓴 제목" },
          "question": { "type": "string", "minLength": 1, "description": "사용자에게 실제로 물은 업무 질문" },
          "recommendation": { "type": "string" },
          "decidedBy": {
            "enum": ["user", "baseline-default", "choice-irrelevant", "deferred"],
            "description": "user=사용자 확인, baseline-default=기본안 적용(미확인), choice-irrelevant=선택 무관, deferred=보류. 고민한 결정과 추천을 그냥 누른 결정을 구분하는 감사 필드."
          },
          "decision": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1, "description": "이 결정이 자동 적용되는 범위" },
          "rationale": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "items": { "type": "string" }, "description": "확인한 소스·명세·데이터·설정·로그" },
          "checkers": { "type": "array", "items": { "type": "string" } },
          "findingIds": { "type": "array", "items": { "type": "string" } },
          "answerableBy": { "type": "string", "description": "developer | operations | integration-owner | security-team 등" },
          "exceptions": { "type": "string" },
          "observation": { "type": "string", "description": "baseline-default일 때 필수. 어디에 무슨 관찰 로그를 넣었는지." },
          "reviewTrigger": { "type": "string", "description": "baseline-default·deferred일 때 필수. 트리거 가능한 재검토 조건." }
        },
        "additionalProperties": true
      }
    }
  }
}
