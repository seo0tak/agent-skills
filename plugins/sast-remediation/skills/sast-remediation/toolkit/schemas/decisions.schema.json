{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sast/decisions.schema.json",
  "title": "SAST 정책 결정",
  "description": "정책 결정 데이터의 정본은 data/decisions.json이다. project/DECISION_LOG.md는 sync가 그 데이터를 읽어 생성한다.",
  "type": "object",
  "required": ["schemaVersion", "workspaceId", "updatedAt", "decisions"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "workspaceId": { "type": "string" },
    "updatedAt": { "type": ["string", "null"], "format": "date-time" },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "decidedAt", "topic", "question", "decidedBy", "decision", "scope", "rationale", "checkers", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "description": "예: DEC-001. 차수 안에서 유일." },
          "decidedAt": { "type": "string", "format": "date-time" },
          "topic": { "type": "string", "minLength": 1, "description": "업무 사실로 쓴 제목" },
          "question": { "type": "string", "minLength": 1, "description": "사용자에게 실제로 물은 업무 질문" },
          "recommendation": { "type": "string" },
          "decidedBy": {
            "enum": ["user", "baseline-default", "choice-irrelevant", "deferred"],
            "description": "user=사용자 확인, baseline-default=기본안 적용(미확인), choice-irrelevant=선택 무관, deferred=보류. 결정의 출처와 처리 유형을 구분해 기록하는 필드. 사용자의 이해 정도나 실제 승인 여부를 이 값만으로 판단하지 않는다."
          },
          "decision": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1, "description": "이 결정이 적용되는 대상과 조건. 실제 변경 권한은 별도로 확인한다." },
          "rationale": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "items": { "type": "string" }, "description": "확인한 소스·명세·데이터·설정·로그" },
          "checkers": { "type": "array", "items": { "type": "string" } },
          "findingIds": { "type": "array", "items": { "type": "string" } },
          "answerableBy": { "type": "string", "description": "developer | operations | integration-owner | security-team 등" },
          "exceptions": { "type": "string" },
          "observation": { "type": "string", "description": "baseline-default일 때 필수. 적용한 관찰 방법, 위치와 확인할 내용을 기록한다." },
          "reviewTrigger": { "type": "string", "description": "baseline-default·deferred일 때 필수. 재검토를 시작할 구체적 조건이나 시점을 기록한다. 확인 담당자와 방법이 정해졌다면 함께 적는다." }
        },
        "additionalProperties": true
      }
    }
  }
}
