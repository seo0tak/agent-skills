# security-assessment 구조도. 고친 뒤 저장소 루트에서 python3 scripts/render_diagrams.py
grid-rows: 3
grid-gap: 40
classes: {
  store: {shape: cylinder; style: {fill: "#f4efe6"; stroke: "#9a7b4f"}}
  proc: {shape: oval; style: {fill: "#e8eefb"; stroke: "#3d5f99"}}
  ext: {style: {fill: "#eeeeee"; stroke: "#777777"; stroke-dash: 3}}
  out: {shape: page; style: {fill: "#ffffff"; stroke: "#3d7a57"}}
  # 구역 제목은 왼쪽 위: 구역을 건너는 선이 가운데 제목을 지나지 않게
  stage: {label.near: top-left; style: {fill: "#fbfbfd"; stroke: "#c5cad6"}}
}
collect: "1 · 인가와 수집" {
  class: stage
  direction: right
  scope: "scope.json\n대상 · 제외 · 기간\n동의 · 웹 요청 상한\n리전 · 자격증명 참조" {class: store}
  adapters: "adapters/*.json\n스캐너 선언 · 웹 범위 제어" {class: store}
  gate: "gate · authorize" {class: proc}
  scan: "scan" {class: proc}
  ext: "외부 스캐너\nsemgrep · checkov\nnuclei · prowler 등" {class: ext}
  operator: "운영자\n(scan이 명령 안내)" {class: ext}
  ingest: "ingest" {class: proc}
  scans: "scans/\n어댑터별 결과\n커버리지 · 기준 건수" {class: store}
  scope -> gate
  gate -> scan
  gate -> ingest
  adapters -> scan
  adapters -> ingest
  scan <-> ext
  scan -> scans
  operator -> ingest: "출력 파일"
  ingest -> scans: "운영자 실행"
}
# 2단은 오른쪽에서 왼쪽으로 흐른다(지그재그). 1단 끝(scans)과 3단 시작(bridge·evidence)이 바로 위아래에 와서
# 구역을 건너는 선이 상자를 가로지르지 않는다.
judge: "2 · 검출과 판정" {
  class: stage
  direction: left
  findings: "findings.json\n합친 결과 · 제외 자산 뺌" {class: store}
  round: "new-round" {class: proc}
  rounds: "rounds/\n지난 차수" {class: store}
  dispositions: "판정 기록\n01 프롬프트" {class: proc}
  disp: "dispositions.json\n판정 · 확인 단계 · 주체" {class: store}
  findings -> round -> rounds
  findings -> dispositions -> disp
  rounds -> dispositions: "해소 비교\n(웹·클라우드는 커버리지)" {style.stroke-dash: 3}
}
# 3단은 증적(체크리스트 → evidence → 산출물)과 넘김(bridge 사슬)을 나란히 둔다. 한 흐름으로 두면
# dispositions에서 bridge로 가는 선이 checklist.json 상자를 지났다.
out: "3 · 넘김과 증적" {
  class: stage
  grid-columns: 2
  grid-gap: 40
  evidence: "증적" {
    style: {fill: "#ffffff"; stroke: "#d9dde6"; stroke-dash: 2}
    direction: right
    checklist: "checklist.json\n방법론 항목 · 결과 · 근거" {class: store}
    ev: "evidence" {class: proc}
    csv: "evidence/findings.csv" {class: out}
    cover: "evidence/cover.md\n기준 대조 · 체크리스트 포함" {class: out}
    ckcsv: "evidence/checklist.csv" {class: out}
    checklist -> ev
    ev -> csv
    ev -> cover
    ev -> ckcsv
  }
  handoff: "넘김" {
    style: {fill: "#ffffff"; stroke: "#d9dde6"; stroke-dash: 2}
    direction: down
    bridge: "bridge" {class: proc}
    sarif: "handoff.sarif" {class: out}
    sr: "sast-remediation" {class: ext}
    bridge -> sarif -> sr
  }
}
collect.scans -> judge.findings: "합침"
judge.disp -> out.handoff.bridge
judge.disp -> out.evidence.ev
